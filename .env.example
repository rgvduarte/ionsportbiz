# Projeto Supabase (Settings > API). Sem estes valores a app arranca em modo demonstração.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# URL público onde a web app fica alojada. É a base dos links pessoais enviados aos convidados.
VITE_PUBLIC_URL=https://ionsportbiz.app

# Caminho base quando a app não está na raiz do domínio (ex.: /plataforma/). Por omissão: /
# VITE_BASE=/

# Força o modo demonstração mesmo com Supabase configurado.
# VITE_DEMO=1
