<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada vai para a cópia de segurança na nuvem (os convites guardados contêm links pessoais).
     A transferência direta entre telemóveis, feita pelo próprio utilizador, mantém-se. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
